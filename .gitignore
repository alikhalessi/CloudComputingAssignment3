cd ~/Documents/Github/CloudComputingAssignment3

cat > .gitignore << 'EOF'
# Python / venv
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/

# Logs
*.log

# Dataset + temp lists (DON'T COMMIT)
images/
images*.txt

# Generated outputs / models (DON'T COMMIT)
out/
*.csv
EOF

git status
git add .gitignore
git commit -m "Ignore local datasets and generated outputs"
git push
